# Database
DATABASE_URL=postgres://admin:admin@localhost:5432/orchestrator?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM Service
LLM_SERVICE_URL=http://127.0.0.1:8000

# Temporal (WSL: use 127.0.0.1:17233, not 127.0.0.1:7233)
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_TASK_QUEUE=orchestrator-task-queue

# Gateway
HTTP_ADDR=:8080

# Feature Flags (Phase 3 - disabled by default)
# Enable DAG workflow mode: set to true after implementing Slice 4.3+
ENABLE_DAG_WORKFLOW=false

# Enable multi-agent mode: set to true after implementing Slice 5
ENABLE_MULTI_AGENT=false

# Enable tool calling: set to true after implementing Slice 6
ENABLE_TOOLS=false


# Real LLM Test (Phase 4B Slice 11) — set REAL_LLM_TEST=1 to enable
# Warning: REAL_LLM_TEST=1 requires a valid API key and a non-mock LLM backend.
# If the key is missing or the backend is in mock mode, the smoke test skips (exit 0).
REAL_LLM_TEST=1
LLM_PROVIDER=minimax
LLM_MODE=openai_compatible
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.7
LLM_API_KEY=sk-your-minimax-api-key-here

# Compatibility: if current OpenAI-compatible client only reads OPENAI_API_KEY
OPENAI_API_KEY=sk-your-minimax-api-key-here