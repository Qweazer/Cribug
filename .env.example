# ============================================================================
# Cribug Platform Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to .env and fill in the values for your deployment.
# Any variable left unset falls back to the defaults baked into the services.
# NEVER commit real API keys to this file — use placeholders only.
# ============================================================================

# ----------------------------------------------------------------------------
# Core Runtime
# ----------------------------------------------------------------------------
ENVIRONMENT=dev
DEBUG=false

# ----------------------------------------------------------------------------
# Proxy (disable inside Docker containers to prevent EOF/500 errors)
# ----------------------------------------------------------------------------
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# http_proxy=
# https_proxy=
# all_proxy=
# NO_PROXY=localhost,127.0.0.1,postgres,redis,qdrant,temporal

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://admin:admin@localhost:5432/orchestrator?sslmode=disable
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=orchestrator
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin
# POSTGRES_SSLMODE=disable

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# Temporal
# ----------------------------------------------------------------------------
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_TASK_QUEUE=orchestrator-task-queue

# ----------------------------------------------------------------------------
# Gateway
# ----------------------------------------------------------------------------
HTTP_ADDR=:8080
GATEWAY_URL=http://127.0.0.1:8080

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
ENABLE_DAG_WORKFLOW=false
ENABLE_MULTI_AGENT=false
ENABLE_TOOLS=false
ENABLE_REACT=false

# ----------------------------------------------------------------------------
# LLM Provider — PRIMARY (MiniMax / OpenAI-compatible)
# ----------------------------------------------------------------------------
REAL_LLM_TEST=1
LLM_PROVIDER=minimax                    # minimax | openai | anthropic | deepseek | groq | ollama
LLM_MODE=openai_compatible              # openai_compatible | anthropic_compatible
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M2.7
LLM_API_KEY=sk-your-minimax-api-key-here
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS_PER_REQUEST=10000

# Additional LLM keys (set if using different provider)
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GOOGLE_API_KEY=your-google-key-here
# GROQ_API_KEY=gsk_your-groq-key-here
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# QWEN_API_KEY=your-qwen-key-here
# MISTRAL_API_KEY=your-mistral-key-here
# XAI_API_KEY=your-xai-key-here
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ----------------------------------------------------------------------------
# Embedding Provider
# ----------------------------------------------------------------------------
REAL_EMBEDDING_TEST=1
EMBEDDING_PROVIDER=google               # google | openai | fake
EMBEDDING_MODEL=gemini-embedding-001    # models/gemini-embedding-001 | text-embedding-3-small | fake
EMBEDDING_DIMENSION=1536
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_API_KEY=your-google-embedding-key-here
EMBEDDING_TIMEOUT_SECONDS=30
# GEMINI_API_KEY=your-gemini-key-here  # same as EMBEDDING_API_KEY for Google

# ----------------------------------------------------------------------------
# Qdrant Vector Database
# ----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SCHEME=http
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------------------
# Embedding Service (Go side)
# ----------------------------------------------------------------------------
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_MAX_SIZE=1000

# ----------------------------------------------------------------------------
# Python LLM Service
# ----------------------------------------------------------------------------
LLM_SERVICE_URL=http://127.0.0.1:8000
PYTHON_LLM_URL=http://127.0.0.1:8000
PYTHON_LLM_SERVICE_URL=http://127.0.0.1:8000

# ----------------------------------------------------------------------------
# Phase 6A: MCP Tool Runtime
# ----------------------------------------------------------------------------
ENABLE_MCP=false
MCP_DEFAULT_TIMEOUT_SEC=30
MCP_RESULT_SIZE_LIMIT_BYTES=65536
CRIBUG_REAL_MCP_TEST=0

# ----------------------------------------------------------------------------
# Phase 6B: Sandbox Runtime
# ----------------------------------------------------------------------------
ENABLE_SANDBOX=false
SANDBOX_RUNNER_PATH=./sandbox/runner/target/release/sandbox-runner
SANDBOX_DEFAULT_TIMEOUT_SEC=30
SANDBOX_DEFAULT_MEMORY_MB=128

# ----------------------------------------------------------------------------
# Phase 6D: Hooks Event System
# ----------------------------------------------------------------------------
ENABLE_HOOKS=false
HOOKS_BLOCKING_ENABLED=false
HOOK_BLOCKING_FAIL_CLOSED=false
HOOK_HANDLER_TIMEOUT_SECONDS=5
HOOK_HANDLER_MAX_RESULT_BYTES=65536
HOOK_ALLOWED_INTERNAL_HANDLERS=audit_logger,log_only,permission_check
HOOK_ALLOWED_HTTP_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# Model Routing & Budgets (from Shannon reference)
# ----------------------------------------------------------------------------
# DEFAULT_MODEL_TIER=small
# COMPLEXITY_MODEL_ID=deepseek-chat
# DECOMPOSITION_MODEL_ID=deepseek-chat
# MAX_TOKENS=2000
# TEMPERATURE=0.7
# MAX_COST_PER_REQUEST=0.50
# LLM_DISABLE_BUDGETS=1
# HISTORY_WINDOW_MESSAGES=50

# ----------------------------------------------------------------------------
# Cache & Rate Limiting (from Shannon reference)
# ----------------------------------------------------------------------------
# ENABLE_CACHE=true
# CACHE_SIMILARITY_THRESHOLD=0.95
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------------------------
# Tool Execution & Workflow Controls
# ----------------------------------------------------------------------------
# TOOL_PARALLELISM=5
# ENFORCE_TIMEOUT_SECONDS=120
# ENFORCE_MAX_TOKENS=32768

# ----------------------------------------------------------------------------
# Web Search Providers (from Shannon reference, optional)
# ----------------------------------------------------------------------------
# WEB_SEARCH_PROVIDER=python
# WEB_FETCH_PROVIDER=python
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# SERPAPI_API_KEY=
# BING_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=

# ----------------------------------------------------------------------------
# Observability & Telemetry
# ----------------------------------------------------------------------------
# OTEL_SERVICE_NAME=cribug
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_ENABLED=false
# LOG_FORMAT=plain

# ----------------------------------------------------------------------------
# Browser Automation (Playwright, from Shannon reference)
# ----------------------------------------------------------------------------
# PLAYWRIGHT_SERVICE_URL=http://playwright-service:8002
# BROWSER_HEADLESS=true

# ----------------------------------------------------------------------------
# Security & Approvals
# ----------------------------------------------------------------------------
# APPROVAL_ENABLED=false
# GATEWAY_SKIP_AUTH=1
# JWT_SECRET=development-only-secret-change-in-production
